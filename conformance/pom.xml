<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>jakarta-portable</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>conformance</artifactId>
    <name>Conformance tests (same tests for every runtime)</name>

    <!--
        No default target: the suite skips itself unless -Dapp.base.url points at a running
        runtime, so `mvn test` works on a machine with no server (see ApiConformanceTest).
    -->
    <properties>
        <app.base.url/>
        <app.health.url/>
    </properties>

    <!--
        These tests talk to a *running* server over HTTP, so the exact same suite runs
        against Quarkus, Open Liberty, WildFly and Payara:

            mvn -pl conformance test -Dapp.base.url=http://localhost:8080 \
                -Dapp.health.url=http://localhost:8080/health
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
        </dependency>
        <!-- RestAssured needs one JSON serializer to send Map bodies; the app itself uses JSON-B. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <app.base.url>${app.base.url}</app.base.url>
                        <app.health.url>${app.health.url}</app.health.url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
